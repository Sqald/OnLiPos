DB_USER=OnLiPos
DB_NAME=OnLiPos

# 必須: openssl rand -hex 64 などで生成してください
SECRET_KEY_BASE=

# アクセス元のホスト名（例: myserver.example.com）。未設定でも動作します
HOST_NAME=

# HTTPSを有効にする場合は true にしてください（Server/nginx/ssl/ に証明書が必要）
FORCE_SSL=false

POSTGRES_DOCKER_VERSION=trixie
NGINX_DOCKER_VERSION=alpine-slim

# オプション: Sentry によるエラー監視。設定しなくても動作します
# SENTRY_DSN=

# バックアップ（Server/backup/backup.sh）
# 2か所目の保存先: ホスト側のディレクトリ（NAS等）と、コンテナ内のパス（指定する場合は /offsite）
BACKUP_OFFSITE_HOST_DIR=
BACKUP_OFFSITE_DIR=
# 失敗時の通知先URL（Slack等のIncoming Webhook。任意）
BACKUP_WEBHOOK_URL=

# 承認トークン（PIN認証）に未対応の旧バージョンの端末を一時的に許可する。
# 全端末の更新が終わったら必ず空に戻すこと（true の間はPIN認証なしで返品等ができてしまう）
ALLOW_LEGACY_OPERATOR_AUTH=

# このバージョンより古い端末アプリを拒否する（例: 1.2.0。空なら確認しない）
MIN_APP_VERSION=
