<%#
  レイアウト: エラーページ専用の簡易レイアウト
  アプリ本体の認証・アセットに依存しない、最小限のヘッダー/フッターのみを持つ。
%>
<!DOCTYPE html>
<html lang="ja">
  <head>
    <title><%= [ content_for(:title) || "エラー", "OnLiPos" ].join(" | ") %></title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
  </head>
  <body class="site-body">
    <header class="main-header">
      <div class="nav-container">
        <a href="/" class="brand"><span class="brand-mark" aria-hidden="true">O</span>OnLiPos</a>
      </div>
    </header>
    <main>
      <%= yield %>
    </main>
    <footer class="main-footer">
      <p class="copyright">&copy; 2026 OnLiPos Project</p>
    </footer>
  </body>
</html>
