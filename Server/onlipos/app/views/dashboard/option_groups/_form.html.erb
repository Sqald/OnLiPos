<%# オプションの入力フォーム %>
<%= form_errors(@group) %>
<%= form_with model: [ :dashboard, @group ] do |f| %>
  <div class="field form-narrow"><label for="option_group_name">名称<%= required_mark %></label><%= f.text_field :name, required: true, placeholder: "例: トッピング" %></div>
  <div class="field-pair form-narrow">
    <div class="field"><%= f.label :min_select, "最低いくつ選ぶか" %><%= f.number_field :min_select, min: 0 %><p class="field-hint">0 なら選ばなくてもかまいません。</p></div>
    <div class="field"><%= f.label :max_select, "最大いくつ選べるか" %><%= f.number_field :max_select, min: 1 %></div>
  </div>
  <h3>選択肢</h3>
  <table class="data-table">
    <thead><tr><th>選択肢の名前</th><th>追加料金（円）</th><th>並び順</th><th>削除する</th></tr></thead>
    <tbody>
      <%= f.fields_for :option_items do |i| %>
        <tr><td><%= i.text_field :name, "aria-label": "選択肢の名前" %></td><td><%= i.number_field :price, min: 0, "aria-label": "追加料金" %></td><td><%= i.number_field :position, "aria-label": "並び順" %></td><td><%= i.check_box :_destroy, "aria-label": "この選択肢を削除" if i.object.persisted? %></td></tr>
      <% end %>
    </tbody>
  </table>
  <div class="actions"><%= f.submit "保存する" %><%= link_to "やめる", dashboard_option_groups_path, class: "link-cancel" %></div>
<% end %>
