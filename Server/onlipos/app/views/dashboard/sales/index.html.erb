<%# ダッシュボード: 売上一覧（店舗・期間で絞り込み。初期表示は過去7日） %>
<%= page_header "売上一覧" do %>
  <%= link_to dashboard_sales_path(format: :csv, store_id: params[:store_id], from: params[:from], to: params[:to]), class: "btn btn-secondary", data: { turbo: false } do %><%= icon(:download, size: 18) %>CSVで出力<% end %>
<% end %>
<%= render layout: "dashboard/shared/filter", locals: { url: dashboard_sales_path, stores: @stores } do |f| %><% end %>
<%= result_count(@sales) %>
<%= data_table([ "日時", "店舗", "端末", "担当者", "レシート番号", "支払方法", "割引", "金額", "" ], @sales.map { |s|
      [ datetime(s.sold_at || s.created_at), s.store.name, s.pos_token&.name || "-", s.employee&.name || "-", s.receipt_number, sale_payment_label(s),
        s.total_discount.positive? ? "-#{yen(s.total_discount)}" : "-",
        s.voided? ? safe_join([ tag.s(yen(s.total_amount)), badge("取消", :danger) ], " ") : yen(s.total_amount),
        row_actions(link_to("くわしく", dashboard_sale_detail_path(s), class: "btn btn-sm btn-secondary", aria: { label: "#{s.receipt_number} をくわしく見る" })) ] },
      empty: "この条件の売上はありません。期間を広げてみてください。") %>
<div class="pagination-wrapper"><%= paginate @sales %></div>
