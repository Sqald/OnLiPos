<%# ダッシュボード: 在庫の入出庫の履歴（初期表示は過去7日） %>
<%= page_header "入出庫の履歴" %>
<%= render layout: "dashboard/shared/filter", locals: { url: dashboard_stock_movements_path, stores: @stores } do |f| %><% end %>
<%= result_count(@movements) %>
<%= data_table([ "日時", "店舗", "商品", "増減", "理由", "レシート番号", "担当者 / 端末" ], @movements.map { |m|
      [ datetime(m.created_at), m.store.name, "#{m.product.name}（#{m.product.code}）", m.quantity_change.positive? ? "+#{m.quantity_change}" : m.quantity_change.to_s, stock_reason_label(m.reason),
        m.sale ? link_to(m.sale.receipt_number, dashboard_sale_detail_path(m.sale)) : "-", [ m.employee&.name, m.pos_token&.name ].compact.join(" / ").presence || "-" ] }, empty: "この条件の履歴はありません。") %>
<div class="pagination-wrapper"><%= paginate @movements %></div>
