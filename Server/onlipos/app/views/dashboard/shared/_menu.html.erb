<%# ダッシュボード: サイドメニュー（dashboard レイアウトから使う）。項目は NavigationHelper#dashboard_nav_groups で定義する。
    目的別のグループに分け、いま開いているグループだけを展開する %>
<nav class="side-nav" aria-label="メインメニュー" data-controller="side-nav">
  <div class="side-nav-search">
    <label class="visually-hidden" for="side-nav-search">メニューを検索</label>
    <%= icon(:search, size: 18) %>
    <input type="search" id="side-nav-search" placeholder="メニューを検索" autocomplete="off" data-side-nav-target="query" data-action="input->side-nav#filter">
  </div>
  <%= link_to dashboard_root_path, class: [ "side-nav-home", ("active" if controller_name == "dashboards") ], aria: { current: ("page" if controller_name == "dashboards") } do %>
    <%= icon(:home) %><span>ホーム</span>
  <% end %>
  <% dashboard_nav_groups.each do |group| %>
    <% badge = group.items.sum { |i| i.badge.to_i } %>
    <details class="side-nav-group" data-side-nav-target="group" data-key="<%= group.key %>" <%= "open" if group == current_nav_group %>>
      <summary><%= icon(group.icon) %><span><%= group.label %></span><% if badge.positive? %><span class="nav-badge" aria-label="未確認<%= badge %>件"><%= badge %></span><% end %><%= icon(:down, size: 16, class: "side-nav-caret") %></summary>
      <ul>
        <% group.items.each do |item| %>
          <li data-side-nav-target="item" data-text="<%= [ group.label, item.label, item.keywords ].compact.join(" ") %>">
            <%= link_to item.path, class: [ "side-nav-link", ("active" if nav_active?(item)) ], aria: { current: ("page" if nav_active?(item)) } do %>
              <span><%= item.label %></span><% if item.badge.to_i.positive? %><span class="nav-badge"><%= item.badge %></span><% end %>
            <% end %>
          </li>
        <% end %>
      </ul>
    </details>
  <% end %>
  <p class="side-nav-empty" data-side-nav-target="empty" hidden>見つかりませんでした。</p>
  <%= link_to dashboard_help_path, class: [ "side-nav-home", ("active" if controller_name == "help") ] do %><%= icon(:help) %><span>使い方ガイド</span><% end %>
</nav>
