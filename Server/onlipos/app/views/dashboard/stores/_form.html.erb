<%# パーシャル: 店舗の登録・編集フォーム。locals: store %>
<%= form_with(model: [ :dashboard, store ], class: "dashboard-form") do |f| %>
  <%= form_errors(store) %>
  <div class="field"><label for="store_name">店舗名<%= required_mark %></label><%= f.text_field :name, placeholder: "例: 渋谷店", autofocus: store.new_record? %></div>
  <div class="field">
    <label for="store_ascii_name">店舗ID<%= required_mark if store.new_record? %></label>
    <% if store.new_record? %>
      <%= f.text_field :ascii_name, placeholder: "例: shibuya01", autocapitalize: "none" %>
      <p class="field-hint">半角英数字。POS端末のログインで使います。<strong>あとから変更できません。</strong></p>
    <% else %>
      <%= f.text_field :ascii_name, disabled: true, class: "form-input-disabled" %>
      <p class="field-hint">店舗IDは変更できません。</p>
    <% end %>
  </div>
  <div class="field"><label for="store_phone_number">電話番号<%= optional_mark %></label><%= f.telephone_field :phone_number, placeholder: "例: 03-1234-5678" %></div>
  <div class="field"><label for="store_address">住所<%= optional_mark %></label><%= f.text_field :address, placeholder: "例: 東京都渋谷区..." %><p class="field-hint">電話番号と住所は、レシートに印字されます。</p></div>
  <div class="field"><label for="store_description">メモ<%= optional_mark %></label><%= f.text_area :description, rows: 3 %></div>
  <div class="actions"><%= f.submit store.new_record? ? "登録する" : "変更を保存" %><%= link_to "やめる", dashboard_stores_path, class: "link-cancel" %></div>
<% end %>
