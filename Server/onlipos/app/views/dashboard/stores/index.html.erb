<%# ダッシュボード: 店舗一覧 %>
<%= page_header "店舗" do %>
  <% if can_write? %><%= link_to new_dashboard_store_path, class: "btn btn-primary" do %><%= icon(:plus, size: 18) %>店舗を登録<% end %><% end %>
<% end %>
<%= data_table([ "店舗名", "店舗ID", "電話番号", "登録日", "操作" ], @stores.map { |s|
      [ s.name, s.ascii_name, s.phone_number.presence || "-", l(s.created_at.to_date),
        can_write? ? row_actions(
          link_to("この店舗の価格", prices_dashboard_store_path(s), class: "btn btn-sm btn-secondary"),
          link_to("編集", edit_dashboard_store_path(s), class: "btn btn-sm btn-secondary"),
          button_to("削除", dashboard_store_path(s), method: :delete, class: "btn btn-sm btn-danger-outline", form: { data: { turbo_confirm: "「#{s.name}」を削除しますか？\nこの店舗のPOS端末や在庫の情報も削除されます。" } })) : "" ] },
      empty: "店舗がまだ登録されていません。", action: (link_to("はじめの店舗を登録する", new_dashboard_store_path, class: "btn btn-primary") if can_write?)) %>
