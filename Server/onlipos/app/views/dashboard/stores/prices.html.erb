<%# ダッシュボード: 店舗別の価格（商品の基本価格を、この店舗だけ上書きする）。空欄なら基本価格を使う %>
<%= page_header "#{@store.name} の価格", back: true, lead: "この店舗だけ値段を変えたい商品に入力してください。空欄の商品は、基本価格のまま販売します。" %>
<%= form_with url: update_prices_dashboard_store_path(@store), method: :patch do |f| %>
  <%= data_table([ "商品コード", "商品名", "基本価格", "この店舗の価格（円）" ], @products.map { |p|
        [ p.code, p.name, yen(p.price), text_field_tag("price_overrides[#{p.id}]", @prices_by_product_id[p.id]&.amount, placeholder: p.price.to_s, type: "number", min: "0", style: "max-width: 150px", "aria-label": "#{p.name} のこの店舗の価格") ] }, empty: "商品がまだ登録されていません。") %>
  <% if @products.any? && can_write? %><div class="sticky-actions card" style="margin-top: 1rem"><%= f.submit "価格を保存", class: "btn btn-primary" %></div><% end %>
<% end %>
