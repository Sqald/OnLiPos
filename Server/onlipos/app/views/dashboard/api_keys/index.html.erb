<%# ダッシュボード: APIキー %>
<%= page_header "APIキー", lead: "ほかのシステムからデータを読み書きするための鍵です。使わない場合は発行しなくてかまいません。" %>
<% if flash[:api_key] %>
  <div class="notice" data-controller="clipboard" data-clipboard-text-value="<%= flash[:api_key] %>"><%= icon(:check) %><div>APIキーを発行しました。<strong>この画面でしか表示されません。</strong><br><code><%= flash[:api_key] %></code> <button type="button" class="btn btn-sm btn-secondary" data-clipboard-target="button" data-action="clipboard#copy">コピー</button></div></div>
<% end %>
<%= data_table([ "用途", "キー", "できること", "最後に使った日時", "状態", "" ], @keys.map { |k| [ k.name, tag.code(k.token_hint), k.scopes.map { |s| ApiKey::SCOPES[s] }.join("、"), datetime(k.last_used_at), k.revoked_at ? badge("無効", false) : badge("有効"),
      k.revoked_at ? "" : row_actions(button_to("無効にする", dashboard_api_key_path(k), method: :delete, class: "btn btn-sm btn-danger-outline", form: { data: { turbo_confirm: "「#{k.name}」を無効にしますか？\nこのキーを使う連携は動かなくなります。" } })) ] }, empty: "APIキーはまだありません。") %>
<h3>新しく発行する</h3>
<div class="dashboard-content form-narrow">
  <%= form_with url: dashboard_api_keys_path, scope: :api_key do |f| %>
    <div class="field"><label for="api_key_name">用途<%= required_mark %></label><%= f.text_field :name, required: true, placeholder: "例: 在庫管理システム" %></div>
    <div class="field">
      <p>できること</p>
      <% ApiKey::SCOPES.each do |scope, label| %><label class="checkbox-item"><%= check_box_tag "api_key[scopes][]", scope, false, id: "scope_#{scope.parameterize}" %> <%= label %></label><% end %>
    </div>
    <div class="actions"><%= f.submit "発行する" %></div>
  <% end %>
  <%= help_note("開発者向けの情報") do %><p>接続先は <code>/api/external/v1</code> です。<code>Authorization: Bearer キー</code> を付けて送ります。</p><% end %>
</div>
