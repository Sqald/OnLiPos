<%# ダッシュボード: 商品一覧画面
    商品のCSV一括登録・検索絞り込み・一覧表示を提供する %>
<div class="dashboard-container">
  <%= render 'dashboard/shared/menu' %>

  <div class="dashboard-content card">
    <div class="subtitle d-flex justify-content-between align-items-center mb-3">
      <h2>商品一覧</h2>
      <div class="d-flex gap-2">
        <%= link_to "CSVで出力", export_dashboard_products_path, class: "btn-sm btn-outline" %>
        <%= link_to "商品登録", new_dashboard_product_path, class: "btn-signup" %>
      </div>
    </div>

    <%# CSVファイルによる商品の一括登録・更新フォーム %>
    <div class="card my-4">
      <div class="card-body">
        <h3 class="card-title">CSVで一括登録・更新</h3>
        <p class="text-muted">
          「CSVで出力」したファイルを編集して取り込めます（UTF-8 / Shift_JIS、5MBまで）。必須の列は <strong>code, name, price</strong> です。<br>
          使える列: <%= Product::CSV_HEADERS.join(", ") %><br>
          tax_type は inclusive（内税）/ exclusive（外税）/ tax_free（非課税）、status は active / discontinued、category・supplier は名称で指定します。<br>
          既存コードの商品は上書きし、空欄の列は変更しません。
        </p>
        <%= form_with(url: import_dashboard_products_path, multipart: true, local: true, class: "d-flex align-items-end") do |form| %>
          <div class="field me-3">
            <%= form.label :file, "CSVファイル", class: "form-label" %>
            <%= form.file_field :file, accept: 'text/csv', class: "form-control" %>
          </div>
          <div class="actions">
            <%= form.submit "インポート", class: "btn-signup" %>
          </div>
        <% end %>
      </div>
    </div>

    <% if @imports.any? %>
      <h3>取込の履歴</h3>
      <%= data_table([ "日時", "ファイル", "状態", "登録", "更新", "エラー" ], @imports.map { |i| [ datetime(i.created_at), i.filename,
            { "queued" => "待機中", "running" => "処理中", "completed" => "完了", "failed" => "失敗" }[i.status], i.imported_count, i.updated_count, safe_join(i.error_messages.first(10), tag.br) ] }) %>
    <% end %>

    <%# 商品名・コード検索、ステータス、カテゴリによる絞り込みフォーム %>
    <div class="filters mb-3">
      <%= form_with url: dashboard_products_path, method: :get, local: true do |f| %>
        <div class="filter-row">
          <div class="filter-item">
            <%= f.label :q, "商品名・コード検索" %><br>
            <%= f.text_field :q, value: params[:q], class: "form-control", placeholder: "商品名またはコード" %>
          </div>
          <div class="filter-item">
            <%= f.label :status, "ステータス" %><br>
            <%= f.select :status,
                  [["すべて", ""], ["有効", "active"], ["廃盤", "discontinued"]],
                  { selected: params[:status] },
                  class: "form-control" %>
          </div>
          <div class="filter-item">
            <%= f.label :category_id, "カテゴリ" %><br>
            <%= f.select :category_id,
                  options_from_collection_for_select(@categories, :id, :name, params[:category_id]),
                  { include_blank: "すべて" }, class: "form-control" %>
          </div>
          <div class="filter-item">
            <br>
            <%= f.submit "検索", class: "btn-signup" %>
          </div>
        </div>
      <% end %>
    </div>

    <%# 商品一覧テーブル %>
    <table class="data-table">
      <thead>
        <tr>
          <th>商品コード</th>
          <th>商品名</th>
          <th>カテゴリ</th>
          <th>基本価格</th>
          <th>原価 / 粗利率</th>
          <th>税率</th>
          <th>ステータス</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @products.each do |product| %>
          <tr>
            <td><%= product.code %></td>
            <td><%= product.name %></td>
            <td><%= product.product_category&.name || "-" %></td>
            <td>
              <%= number_to_currency(product.price) %>
              <% if product.sold_by_weight? %>
                <span class="status-badge status-inactive">量り売り(100gあたり)</span>
              <% end %>
            </td>
            <td><%= product.cost_price ? "#{yen(product.cost_price)} / #{product.profit_rate}%" : "-" %></td>
            <td><%= product.tax_rate %>%<%= " / 店内#{product.eat_in_tax_rate}%" if product.eat_in_tax_rate %> <%= Product.tax_type_label(product.tax_type) unless product.tax_inclusive? %></td>
            <td>
              <span class="status-badge <%= product.active? ? 'status-active' : 'status-inactive' %>">
                <%= product.status_i18n %>
              </span>
            </td>
            <td>
              <%= link_to "編集", edit_dashboard_product_path(product), class: "btn-sm btn-outline" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <%= paginate @products %>
  </div>
</div>
