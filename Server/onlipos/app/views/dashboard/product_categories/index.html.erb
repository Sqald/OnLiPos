<%# ダッシュボード: 商品カテゴリ一覧 %>
<%= page_header "カテゴリ", lead: "商品を分類します。レジの商品一覧の並びにも使われます。" do %>
  <% if can_write? %><%= link_to new_dashboard_product_category_path, class: "btn btn-primary" do %><%= icon(:plus, size: 18) %>カテゴリを登録<% end %><% end %>
<% end %>
<%= data_table([ "表示順", "カテゴリ名", "商品数", "操作" ], @categories.map { |c|
      [ c.display_order, c.name, "#{c.products.count}件",
        can_write? ? row_actions(link_to("編集", edit_dashboard_product_category_path(c), class: "btn btn-sm btn-secondary"),
          button_to("削除", dashboard_product_category_path(c), method: :delete, class: "btn btn-sm btn-danger-outline", form: { data: { turbo_confirm: "「#{c.name}」を削除しますか？\nこのカテゴリの商品は「カテゴリなし」になります。" } })) : "" ] },
      empty: "カテゴリがまだ登録されていません。", action: (link_to("カテゴリを登録する", new_dashboard_product_category_path, class: "btn btn-primary") if can_write?)) %>
