<%# ダッシュボード: 商品カテゴリ登録/編集フォーム(new/editの両画面から render される共通パーシャル) %>
<%= form_with(model: [:dashboard, category], local: true, class: "dashboard-form") do |f| %>
  <% if category.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(category.errors.count, "件のエラー") %>が発生しました:</h2>
      <ul>
        <% category.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= f.label :name, "カテゴリ名" %>
    <%= f.text_field :name, placeholder: "例: 食品" %>
  </div>

  <div class="field">
    <%= f.label :display_order, "表示順（小さいほど先頭）" %>
    <%= f.number_field :display_order, min: 0, value: category.new_record? ? 0 : category.display_order %>
  </div>

  <div class="actions">
    <%= f.button category.new_record? ? "登録する" : "更新する",
        type: "button",
        class: "btn-signup",
        onclick: "this.form.submit();" %>
    <%= link_to "キャンセル", dashboard_product_categories_path, class: "link-cancel" %>
  </div>
<% end %>
