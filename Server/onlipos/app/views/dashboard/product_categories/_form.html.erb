<%# ダッシュボード: 商品カテゴリの登録/編集フォーム %>
<%= form_with(model: [ :dashboard, category ], class: "dashboard-form") do |f| %>
  <%= form_errors(category) %>
  <div class="field"><label for="product_category_name">カテゴリ名<%= required_mark %></label><%= f.text_field :name, placeholder: "例: 食品", autofocus: true %></div>
  <div class="field"><%= f.label :display_order, "表示順" %><%= f.number_field :display_order, min: 0, value: category.new_record? ? 0 : category.display_order %><p class="field-hint">小さい数字ほど先に表示されます。</p></div>
  <div class="actions"><%= f.submit category.new_record? ? "登録する" : "変更を保存" %><%= link_to "やめる", dashboard_product_categories_path, class: "link-cancel" %></div>
<% end %>
