<%# ダッシュボード: 電子ジャーナルの改ざん検証 %>
<%= page_header "改ざんの確認", back: true, lead: "端末ごとに、番号の抜け・書き換え・末尾の削除がないかを調べた結果です（毎日自動でも調べています）。" %>
<%= data_table([ "店舗 / 端末", "結果" ], @results.map { |pos, issues| [ "#{pos.store.name} / #{pos.name}", issues.empty? ? badge("正常") : safe_join([ badge("問題あり", :danger), *issues.first(20) ], tag.br) ] }) %>
