<%# ダッシュボード: セット商品一覧 %>
<%= page_header "セット商品", lead: "複数の商品をまとめて、1つのコードで販売できます。" do %>
  <% if can_write? %><%= link_to new_dashboard_product_bundle_path, class: "btn btn-primary" do %><%= icon(:plus, size: 18) %>セット商品を登録<% end %><% end %>
<% end %>
<%= data_table([ "コード", "セット名", "価格", "状態", "中身", "操作" ], @bundles.map { |b|
      [ tag.span(b.code), b.name, b.price.to_i.zero? ? "構成商品の合計" : yen(b.price), badge(b.active? ? "販売中" : "廃盤", b.active?), "#{b.product_bundle_items.size}商品",
        can_write? ? row_actions(link_to("編集", edit_dashboard_product_bundle_path(b), class: "btn btn-sm btn-secondary"),
          button_to("削除", dashboard_product_bundle_path(b), method: :delete, class: "btn btn-sm btn-danger-outline", form: { data: { turbo_confirm: "「#{b.name}」を削除しますか？" } })) : "" ] },
      empty: "セット商品がまだ登録されていません。", action: (link_to("セット商品を登録する", new_dashboard_product_bundle_path, class: "btn btn-primary") if can_write?)) %>
