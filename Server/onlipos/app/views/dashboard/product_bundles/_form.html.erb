<%# ダッシュボード: セット商品の登録/編集フォーム。構成商品の行の追加・削除は bundle_items_controller.js（Stimulus）で行う %>
<%= form_with(model: [ :dashboard, bundle ], class: "dashboard-form",
              data: { controller: "bundle-items", bundle_items_products_value: @products.map { |p| { id: p.id, label: "#{p.code} - #{p.name}" } }.to_json }) do |f| %>
  <%= form_errors(bundle) %>
  <fieldset class="form-section">
    <legend>基本</legend>
    <div class="field"><label for="product_bundle_code">セットコード<%= required_mark %></label><%= f.text_field :code, placeholder: "例: SET001" %><p class="field-hint">レジで読み取るコード（バーコード）です。</p></div>
    <div class="field"><label for="product_bundle_name">セット名<%= required_mark %></label><%= f.text_field :name, placeholder: "例: ランチセット" %></div>
    <div class="field"><%= f.label :price, "セット価格（税込）" %><div class="input-unit"><%= f.number_field :price, min: 0 %><span>円</span></div><p class="field-hint">0 にすると、中身の商品の合計金額で会計します。</p></div>
    <div class="field">
      <span class="field-label">状態</span>
      <div class="radio-group">
        <%= f.radio_button :status, :active, checked: bundle.active? || bundle.new_record? %><%= f.label :status_active, "販売中" %>
        <%= f.radio_button :status, :discontinued %><%= f.label :status_discontinued, "廃盤" %>
      </div>
    </div>
  </fieldset>
  <fieldset class="form-section">
    <legend>セットの中身</legend>
    <table class="data-table" id="bundle-items-table">
      <thead><tr><th>商品</th><th style="width: 110px">数量</th><th style="width: 80px"></th></tr></thead>
      <tbody id="bundle-items-body" data-bundle-items-target="body">
        <% existing_items = bundle.product_bundle_items.includes(:product) %>
        <% (existing_items.any? ? existing_items : [ nil ]).each do |item| %>
          <tr class="bundle-item-row">
            <td><%= select_tag "items[][product_id]", options_for_select(@products.map { |p| [ "#{p.code} - #{p.name}", p.id ] }, item&.product_id), include_blank: "商品を選んでください", id: nil, "aria-label": "商品" %></td>
            <td><%= number_field_tag "items[][quantity]", item&.quantity || 1, min: 1, id: nil, "aria-label": "数量" %></td>
            <td><button type="button" class="btn btn-sm btn-danger-outline" data-action="bundle-items#remove">削除</button></td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <p style="margin-top: 0.75rem"><button type="button" class="btn btn-secondary" id="add-item-btn" data-action="bundle-items#add"><%= icon(:plus, size: 18) %>商品を追加</button></p>
  </fieldset>
  <div class="actions">
    <%= f.button bundle.new_record? ? "登録する" : "変更を保存", type: "button", class: "btn btn-primary", data: { controller: "form-submit", action: "form-submit#submit" } %>
    <%= link_to "やめる", dashboard_product_bundles_path, class: "link-cancel" %>
  </div>
<% end %>
