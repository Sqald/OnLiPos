<%# ダッシュボード: 棚卸 %>
<div class="dashboard-container">
  <%= render "dashboard/shared/menu" %>
  <div class="dashboard-content card">
    <div class="subtitle"><h2>棚卸</h2></div>
    <% if can_write? %>
      <%= form_with url: dashboard_stocktakes_path, scope: :stocktake do |f| %>
        <div class="filter-row">
          <div class="filter-item"><%= f.label :store_id, "店舗" %><br><%= f.select :store_id, @stores.pluck(:name, :id) %></div>
          <div class="filter-item"><%= f.label :name, "名称" %><br><%= f.text_field :name, value: "#{Date.current.strftime("%Y年%m月")} 棚卸", required: true %></div>
          <div class="filter-item"><br><%= f.submit "棚卸を開始", class: "btn-signup" %></div>
        </div>
      <% end %>
    <% end %>
    <%= data_table([ "名称", "店舗", "状態", "登録商品", "開始", "確定", "" ], @stocktakes.map { |s| [ s.name, s.store.name, Stocktake::STATUS_LABELS[s.status], s.items.size, datetime(s.created_at), "#{datetime(s.completed_at)} #{s.completed_by_name}", link_to("詳細", dashboard_stocktake_path(s)) ] }) %>
    <div class="pagination-wrapper"><%= paginate @stocktakes %></div>
  </div>
</div>
