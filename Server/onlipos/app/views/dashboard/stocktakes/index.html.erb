<%# ダッシュボード: 棚卸 %>
<%= page_header "棚卸", lead: "実際の在庫を数えて、帳簿の在庫数に反映します。端末の「棚卸」からも数えられます。" %>
<% if can_write? && @stores.any? %>
  <div class="filters">
    <%= form_with url: dashboard_stocktakes_path, scope: :stocktake do |f| %>
      <div class="filter-row">
        <div class="filter-item"><%= f.label :store_id, "店舗" %><%= f.select :store_id, @stores.pluck(:name, :id) %></div>
        <div class="filter-item wide"><%= f.label :name, "名前" %><%= f.text_field :name, value: "#{Date.current.strftime("%Y年%-m月")} 棚卸", required: true %></div>
        <div class="filter-item"><%= f.submit "棚卸を始める", class: "btn btn-primary" %></div>
      </div>
    <% end %>
  </div>
<% end %>
<%= data_table([ "名前", "店舗", "状態", "数えた商品", "開始", "確定", "" ], @stocktakes.map { |s| [ s.name, s.store.name, badge(Stocktake::STATUS_LABELS[s.status], s.counting? ? :warning : s.status != "cancelled"), "#{s.items.size}件", datetime(s.created_at), s.completed_at ? "#{datetime(s.completed_at)} #{s.completed_by_name}" : "-", row_actions(link_to("開く", dashboard_stocktake_path(s), class: "btn btn-sm btn-secondary")) ] }, empty: "棚卸はまだありません。") %>
<div class="pagination-wrapper"><%= paginate @stocktakes %></div>
