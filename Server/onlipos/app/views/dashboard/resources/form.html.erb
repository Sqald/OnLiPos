<%# ダッシュボード: マスタ登録・変更の共通画面（Dashboard::ResourceController） %>
<div class="dashboard-container">
  <%= render "dashboard/shared/menu" %>
  <div class="dashboard-content card dashboard-form-card">
    <div class="subtitle"><h2><%= resource_config[:title] %>の<%= @record.new_record? ? "登録" : "変更" %></h2></div>
    <%= form_errors(@record) %>
    <% url = @record.new_record? ? url_for(action: :create) : url_for(action: :update, id: @record) %>
    <%= form_with model: @record, url: url, scope: resource_config[:model].model_name.param_key do |f| %>
      <% resource_config[:fields].each do |field| %>
        <div class="field">
          <% opts = field.options.slice(:min, :max, :placeholder, :required, :maxlength, :rows) %>
          <% case field.type %>
          <% when :checkbox %>
            <label><%= f.check_box field.name %> <%= field.label %></label>
          <% when :checkboxes %>
            <%= f.label field.name, field.label %>
            <div class="store-grid">
              <% field_choices(field).each do |text, value| %>
                <label class="checkbox-item"><%= check_box_tag "#{f.object_name}[#{field.name}][]", value, Array(@record.public_send(field.name)).map(&:to_s).include?(value.to_s), id: "#{field.name}_#{value}" %> <%= text %></label>
              <% end %>
              <%= hidden_field_tag "#{f.object_name}[#{field.name}][]", "", id: nil %>
            </div>
          <% when :select %>
            <%= f.label field.name, field.label %>
            <%= f.select field.name, field_choices(field), { include_blank: field.options[:blank] }, class: "form-select" %>
          <% when :textarea %>
            <%= f.label field.name, field.label %>
            <%= f.text_area field.name, opts.merge(class: "form-select", style: "height:auto") %>
          <% when :number %>
            <%= f.label field.name, field.label %><%= f.number_field field.name, opts %>
          <% when :date %>
            <%= f.label field.name, field.label %><%= f.date_field field.name, opts %>
          <% when :datetime %>
            <%= f.label field.name, field.label %><%= f.datetime_local_field field.name, opts %>
          <% else %>
            <%= f.label field.name, field.label %><%= f.text_field field.name, opts %>
          <% end %>
          <% if field.options[:hint] %><p class="text-sm-muted"><%= field.options[:hint] %></p><% end %>
        </div>
      <% end %>
      <div class="actions"><%= f.submit "保存", class: "btn-signup" %> <%= link_to "戻る", { action: :index }, class: "link-cancel" %></div>
    <% end %>
  </div>
</div>
