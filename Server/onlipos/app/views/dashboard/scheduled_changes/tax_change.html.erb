<%# ダッシュボード: 税率の一括変更 %>
<%= page_header "税率をまとめて変更", back: true, lead: "対象の税率の商品を、指定した日からまとめて新しい税率に変えます。店内飲食用の税率は変わりません。" %>
<p class="callout warning"><%= icon(:alert) %><span>酒類など対象にしたくない商品は、カテゴリを分けて「除外するカテゴリ」で選んでください。</span></p>
<div class="dashboard-content form-narrow">
  <%= form_with url: tax_change_dashboard_scheduled_changes_path, method: :get do |f| %>
    <div class="field"><label for="effective_on">いつから<%= required_mark %></label><%= f.date_field :effective_on, value: params[:effective_on], required: true, min: Date.tomorrow %></div>
    <div class="field-pair">
      <div class="field"><%= f.label :from_rate, "いまの税率" %><div class="input-unit"><%= f.number_field :from_rate, value: params[:from_rate] || 8, min: 0, max: 100, required: true %><span>%</span></div></div>
      <div class="field"><%= f.label :to_rate, "新しい税率" %><div class="input-unit"><%= f.number_field :to_rate, value: params[:to_rate] || 1, min: 0, max: 100, required: true %><span>%</span></div></div>
    </div>
    <div class="field"><%= f.label :keep, "内税の商品の値段" %><%= f.select :keep, options_for_select([ [ "税抜の金額はそのまま（税込の値段が変わる）", "ex_tax" ], [ "税込の値段はそのまま", "in_tax" ] ], params[:keep]) %></div>
    <% if @categories.any? %>
      <div class="field">
        <p>除外するカテゴリ</p>
        <div class="store-grid"><% @categories.each do |c| %><label class="checkbox-item"><%= check_box_tag "excluded_category_ids[]", c.id, Array(params[:excluded_category_ids]).include?(c.id.to_s), id: "cat_#{c.id}" %> <%= c.name %></label><% end %></div>
      </div>
    <% end %>
    <div class="actions"><%= f.submit "変更内容を確認する", name: nil %><span class="text-sm-muted">この時点ではまだ変更されません。</span></div>
  <% end %>
</div>
<% if @rows %>
  <h2 style="font-size: 1.2rem; margin: 2rem 0 0.75rem">変更内容（<%= @rows.size %>件）</h2>
  <%= data_table([ "商品", "対象", "税率", "いまの価格", "新しい価格" ], @rows.first(300).map { |r| [ "#{r.product.name}（#{r.product.code}）", r.store&.name || "全店舗", "#{params[:from_rate].to_i}% → #{params[:to_rate].to_i}%", yen(r.current_price), yen(r.new_price) ] }, empty: "対象の商品はありません。") %>
  <% if @rows.size > 300 %><p class="text-sm-muted">先頭の300件を表示しています。</p><% end %>
  <% if @rows.any? && can_write? %>
    <%= form_with url: apply_tax_change_dashboard_scheduled_changes_path, method: :post, class: "actions", data: { turbo_confirm: "#{@rows.size}件の変更を予約しますか？" } do |f| %>
      <% request.query_parameters.slice("effective_on", "from_rate", "to_rate", "keep").each do |k, v| %><%= hidden_field_tag k, v, id: nil %><% end %>
      <% Array(params[:excluded_category_ids]).each do |id| %><%= hidden_field_tag "excluded_category_ids[]", id, id: nil %><% end %>
      <%= f.submit "この内容で予約する" %>
    <% end %>
  <% end %>
<% end %>
