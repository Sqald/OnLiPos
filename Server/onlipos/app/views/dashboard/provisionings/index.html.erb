<%# ダッシュボード: 端末の初期設定（プロビジョニング）一覧 %>
<%= page_header "端末の初期設定", lead: "店舗モードやレシートプリンターなどの設定をまとめて登録し、POS端末に適用できます。" do %>
  <% if can_write? %><%= link_to new_dashboard_provisioning_path, class: "btn btn-primary" do %><%= icon(:plus, size: 18) %>設定を追加<% end %><% end %>
<% end %>
<%= data_table([ "設定の名前", "店舗", "使っている端末", "作成日", "操作" ], @provisionings.map { |p| [ p.name, p.store.name, p.pos_tokens.map(&:name).join("、").presence || "-", l(p.created_at.to_date),
      can_write? ? row_actions(button_to("削除", dashboard_provisioning_path(p), method: :delete, class: "btn btn-sm btn-danger-outline", form: { data: { turbo_confirm: "「#{p.name}」を削除しますか？" } })) : "" ] },
      empty: "端末の初期設定はまだありません。", action: (link_to("設定を追加する", new_dashboard_provisioning_path, class: "btn btn-primary") if can_write?)) %>
