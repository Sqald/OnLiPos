<%# ダッシュボード: POS端末の登録（パスワードは自動で作られ、登録後に一度だけ表示される） %>
<%= page_header "POS端末を追加", back: true %>
<div class="dashboard-content form-narrow">
  <%= form_errors(@pos_token) %>
  <%= form_with(model: @pos_token, url: dashboard_pos_devices_path) do |f| %>
    <div class="field">
      <label for="pos_token_store_id">使う店舗<%= required_mark %></label>
      <%= f.collection_select :store_id, @stores, :id, :name, { prompt: "選んでください" }, { required: true } %>
    </div>
    <div class="field">
      <label for="pos_token_name">端末の名前<%= required_mark %></label>
      <%= f.text_field :name, placeholder: "例: レジカウンター1", autofocus: true, required: true %>
      <p class="field-hint">画面で見分けるための名前です。同じ店舗の中で重ならないようにしてください。</p>
    </div>
    <div class="field">
      <label for="pos_token_ascii_name">端末ID<%= required_mark %></label>
      <%= f.text_field :ascii_name, placeholder: "例: pos1", required: true, autocapitalize: "none" %>
      <p class="field-hint">半角英数字3〜16文字。端末アプリへのログインで使います。</p>
    </div>
    <div class="field">
      <label for="pos_token_provisioning_id">端末の初期設定<%= optional_mark %></label>
      <%= f.collection_select :provisioning_id, @provisionings, :id, :name, { include_blank: "指定しない" } %>
      <p class="field-hint">レシートプリンターや店舗モードの設定をまとめて適用できます。</p>
    </div>
    <p class="callout"><%= icon(:info) %><span>パスワードは自動で作られ、登録後に<strong>一度だけ</strong>表示されます。すぐに控えてください。</span></p>
    <div class="actions"><%= f.submit "登録する" %><%= link_to "やめる", dashboard_pos_devices_path, class: "link-cancel" %></div>
  <% end %>
</div>
