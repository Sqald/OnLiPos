<%# ダッシュボード: レジ金の履歴（開設・点検・精算で数えた現金の記録）。初期表示は過去7日 %>
<%= page_header "レジ金の履歴", lead: "レジの開設・点検・精算のときに数えた現金の記録です。" %>
<%= render layout: "dashboard/shared/filter", locals: { url: dashboard_cash_logs_path, stores: @stores } do |f| %>
  <div class="filter-item"><%= f.label :pos_token_id, "端末" %><%= f.select :pos_token_id, options_for_select(@stores.flat_map(&:pos_tokens).map { |pt| [ "#{pt.store.name} / #{pt.name}", pt.id ] }, params[:pos_token_id]), { include_blank: "すべて" } %></div>
  <div class="filter-item"><%= f.label :kind, "種類" %><%= f.select :kind, options_for_select([ [ "すべて", "" ], [ "開設", "open" ], [ "点検", "check" ], [ "精算", "close" ] ], params[:kind]) %></div>
<% end %>
<%= result_count(@cash_logs) %>
<%= data_table([ "営業日", "店舗", "端末", "担当者", "種類", "数えた金額" ], @cash_logs.map { |c|
      [ l(c.open_date), c.pos_token.store.name, c.pos_token.name, c.employee.name, c.is_start? ? badge("開設") : (c.is_end? ? badge("精算", :warning) : badge("点検", false)), yen(c.total_amount) ] }, empty: "この条件の記録はありません。") %>
<div class="pagination-wrapper"><%= paginate @cash_logs %></div>
