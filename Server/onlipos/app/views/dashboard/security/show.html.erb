<%# ダッシュボード: セキュリティ設定（2段階認証の管理） %>
<div class="dashboard-container">
  <%= render 'dashboard/shared/menu' %>

  <div class="dashboard-content card mfa-settings">
    <div class="subtitle"><h2>セキュリティ設定</h2></div>
    <p class="mfa-lead">ダッシュボードへのログインには、パスワードに加えて次のいずれかによる2段階認証が必要です。端末の故障・紛失に備えて、2つ以上登録しておくことをおすすめします。</p>

    <section class="mfa-section">
      <h3>パスキー</h3>
      <% if @passkeys.any? %>
        <table class="data-table">
          <thead><tr><th>名前</th><th>登録日時</th><th>最終利用</th><th></th></tr></thead>
          <tbody>
            <% @passkeys.each do |pk| %>
              <tr>
                <td><%= pk.nickname %></td>
                <td><%= l(pk.created_at, format: "%Y/%m/%d %H:%M") %></td>
                <td><%= pk.last_used_at ? l(pk.last_used_at, format: "%Y/%m/%d %H:%M") : "-" %></td>
                <td><%= button_to "削除", dashboard_security_passkey_path(pk), method: :delete, class: "btn-sm btn-danger-outline",
                                  data: { turbo_confirm: "パスキー「#{pk.nickname}」を削除しますか？" } %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <p class="mfa-note">登録されていません。</p>
      <% end %>
      <%= render "users/mfa/passkey_button", mode: "register", label: "パスキーを追加", nickname: true,
                 options_url: dashboard_security_passkey_options_path, verify_url: dashboard_security_passkeys_path %>
    </section>

    <section class="mfa-section">
      <h3>認証アプリ</h3>
      <% if current_user.otp_enabled? %>
        <p>登録済み（<%= l(current_user.otp_enabled_at, format: "%Y/%m/%d %H:%M") %>）</p>
        <%= button_to "認証アプリの登録を解除", dashboard_security_totp_path, method: :delete, class: "btn-sm btn-danger-outline",
                      data: { turbo_confirm: "認証アプリの登録を解除しますか？" } %>
      <% else %>
        <p class="mfa-note">登録されていません。</p>
        <%= link_to "認証アプリを登録", dashboard_new_security_totp_path, class: "btn-signup" %>
      <% end %>
    </section>

    <section class="mfa-section">
      <h3>リカバリーコード</h3>
      <p>パスキーや認証アプリが使えなくなったときに、1回だけ使えるコードです。残り <strong><%= current_user.recovery_codes_remaining %></strong> 個。</p>
      <%= button_to "リカバリーコードを再発行", dashboard_security_recovery_codes_path, method: :post, class: "btn-sm btn-outline",
                    data: { turbo_confirm: "再発行すると、今までのリカバリーコードはすべて使えなくなります。よろしいですか？" } %>
    </section>
  </div>
</div>
