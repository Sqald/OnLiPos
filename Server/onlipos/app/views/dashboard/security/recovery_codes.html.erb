<%# ダッシュボード: 発行したリカバリーコードを一度だけ表示する %>
<%= page_header "リカバリーコード", lead: "スマートフォンをなくしたときなどに、ログインの2段階目で使うコードです（各コード1回だけ使えます）。" %>
<div class="dashboard-content form-narrow">
  <p class="mfa-warning"><strong>この画面でしか表示されません。</strong>印刷するか、パスワードマネージャーなどの安全な場所に保管してください。</p>
  <ul class="mfa-codes"><% @codes.each do |code| %><li><code><%= code %></code></li><% end %></ul>
  <div class="actions" data-controller="clipboard" data-clipboard-text-value="<%= @codes.join("\n") %>">
    <%= link_to "保管しました", dashboard_root_path, class: "btn btn-primary" %>
    <button type="button" class="btn btn-secondary" data-clipboard-target="button" data-action="clipboard#copy">コピー</button>
  </div>
</div>
