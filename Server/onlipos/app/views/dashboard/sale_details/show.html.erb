<%# ダッシュボード: 売上の詳細（基本情報・支払い・明細・返品の状態） %>
<%= page_header "売上の詳細", back: [ "売上一覧に戻る", dashboard_sales_path ] %>
<% if @sale.voided? %><p class="callout warning"><%= icon(:alert) %><span>この会計は取り消されています。</span></p><% end %>
<%= detail_table([
      [ "日時", datetime(@sale.sold_at || @sale.created_at) ], [ "店舗 / 端末", [ @sale.store.name, @sale.pos_token&.name ].compact.join(" / ") ],
      [ "レシート番号", @sale.receipt_number ], [ "担当者", @sale.employee ? "#{@sale.employee.name}（#{@sale.employee.code}）" : "-" ],
      [ "合計（税込）", tag.strong(yen(@sale.total_amount)) ],
      ([ "税抜 / 消費税", "#{yen(@sale.subtotal_ex_tax)} / #{yen(@sale.tax_amount)}" ] if @sale.subtotal_ex_tax.positive?),
      ([ "割引の合計", tag.span("-#{yen(@sale.total_discount)}", class: "minus") ] if @sale.total_discount.positive?),
      ([ "返品", safe_join(@sale.refunds.map { |r| safe_join([ badge("返品あり", :warning), " ", link_to(r.refund_receipt_number, dashboard_refund_path(r)), "（返金 #{yen(r.total_amount)}）" ]) }, tag.br) ] if @sale.refunds.any?)
    ].compact) %>
<h3>支払い</h3>
<%= data_table([ "方法", "金額" ], @sale.sale_payments.any? ? @sale.sale_payments.map { |p| [ PaymentMethods.label(p.method), yen(p.amount) ] } : [ [ PaymentMethods.label(@sale.payment_method), yen(@sale.total_amount) ] ]) %>
<h3>買った商品</h3>
<%= data_table([ "商品コード", "商品名", "数量", "単価", "割引", "値引きの理由", "小計", "税率" ], @sale.saledetails.map { |d|
      discounted = d.original_unit_price.present? && d.original_unit_price > d.unit_price
      [ d.product&.code || "-", d.product_name, d.quantity, discounted ? safe_join([ tag.span(yen(d.original_unit_price), class: "strike"), yen(d.unit_price) ], " ") : yen(d.unit_price),
        d.discount_amount.positive? ? "-#{yen(d.discount_amount)}" : "-", d.discount_reason.presence || "-", yen(d.subtotal), d.tax_rate.positive? ? "#{d.tax_rate}%" : "-" ] }) %>
