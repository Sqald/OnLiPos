<%# ダッシュボード: 店舗在庫。一覧で探し、商品を選ぶと店舗ごとの数量の変更・店舗間の移動ができる %>
<% if @jan_code.present? %>
  <%= page_header @product ? "#{@product.name} の在庫" : "店舗在庫", back: [ "在庫一覧に戻る", dashboard_store_stocks_path ], lead: (@product && "商品コード #{@product.code}") %>
  <% if @product.nil? %>
    <%= empty_message("「#{@jan_code}」の商品が見つかりませんでした。", action: link_to("在庫一覧から探す", dashboard_store_stocks_path, class: "btn btn-secondary")) %>
  <% else %>
    <%= data_table([ "店舗", "在庫数" ], @store_stocks.map { |ss|
          [ ss.store.name, can_write? ? form_with(model: [ :dashboard, ss ], method: :patch, class: "row-actions") { |f|
            safe_join([ hidden_field_tag(:jan_code, @jan_code, id: nil), f.number_field(:quantity, value: ss.quantity, style: "max-width: 130px", "aria-label": "#{ss.store.name} の在庫数"), f.submit("変更", class: "btn btn-sm btn-primary") ]) } : number_with_delimiter(ss.quantity) ] },
          empty: "この商品の在庫はまだ登録されていません。") %>
    <% if @store_stocks.size >= 2 && can_write? %>
      <h3>ほかの店舗へ移す</h3>
      <div class="filters">
        <%= form_with url: transfer_dashboard_store_stocks_path, method: :post do |f| %>
          <%= hidden_field_tag :jan_code, @jan_code, id: nil %>
          <% options = options_from_collection_for_select(@store_stocks.map(&:store), :id, :name) %>
          <div class="filter-row">
            <div class="filter-item"><%= label_tag :from_store_id, "どこから" %><%= select_tag :from_store_id, options %></div>
            <div class="filter-item"><%= label_tag :to_store_id, "どこへ" %><%= select_tag :to_store_id, options_from_collection_for_select(@store_stocks.map(&:store), :id, :name, @store_stocks.second.store_id) %></div>
            <div class="filter-item"><%= label_tag :quantity, "個数" %><%= number_field_tag :quantity, 1, min: 1 %></div>
            <div class="filter-item"><%= submit_tag "移動する", class: "btn btn-primary" %></div>
          </div>
        <% end %>
      </div>
    <% end %>
  <% end %>
<% else %>
  <%= page_header "店舗在庫" %>
  <div class="filters">
    <%= form_with url: dashboard_store_stocks_path, method: :get do |f| %>
      <div class="filter-row">
        <div class="filter-item wide"><%= f.label :q, "商品名・商品コード" %><%= f.search_field :q, value: params[:q], placeholder: "例: おにぎり / 4901234567890" %></div>
        <div class="filter-item"><%= f.label :store_id, "店舗" %><%= f.select :store_id, options_from_collection_for_select(@stores, :id, :name, params[:store_id]), { include_blank: "すべての店舗" } %></div>
        <div class="filter-item"><%= f.submit "探す", class: "btn btn-primary", name: nil %></div>
      </div>
    <% end %>
  </div>
  <%= result_count(@stocks) %>
  <%= data_table([ "商品コード", "商品名", "店舗", "在庫数", "状態", "" ], @stocks.map { |ss|
        threshold = ss.product.low_stock_threshold
        [ ss.product.code, ss.product.name, ss.store.name, ss.quantity, ss.quantity <= 0 ? badge("在庫なし", :danger) : (threshold && ss.quantity <= threshold ? badge("残りわずか", :warning) : badge("あり")),
          row_actions(link_to(can_write? ? "変更・移動" : "くわしく", dashboard_store_stocks_path(jan_code: ss.product.code), class: "btn btn-sm btn-secondary", aria: { label: "#{ss.product.name} の在庫" })) ] },
        empty: params[:q].present? ? "条件に合う商品の在庫はありません。" : "在庫はまだ登録されていません。入荷や棚卸を行うと表示されます。") %>
  <div class="pagination-wrapper"><%= paginate @stocks %></div>
<% end %>
