<%# ダッシュボード: 発注の作成 %>
<div class="dashboard-container">
  <%= render "dashboard/shared/menu" %>
  <div class="dashboard-content card">
    <div class="subtitle"><h2>発注の作成</h2></div>
    <%= form_with url: new_dashboard_purchase_order_path, method: :get do |f| %>
      <p>店舗と仕入先を選ぶと、在庫が不足している商品を初期値にできます。
      <%= f.select :store_id, options_from_collection_for_select(@stores, :id, :name, @order.store_id) %>
      <%= f.select :supplier_id, options_from_collection_for_select(@suppliers, :id, :name, @order.supplier_id) %>
      <%= f.submit "不足商品を読み込む", class: "btn-sm btn-outline" %></p>
    <% end %>
    <%= render "form" %>
  </div>
</div>
