<%# ダッシュボード: 発注の詳細 %>
<div class="dashboard-container">
  <%= render "dashboard/shared/menu" %>
  <div class="dashboard-content card">
    <div class="subtitle"><h2>発注の詳細</h2></div>
    <%= detail_table([ [ "番号", @order.number ], [ "店舗", @order.store.name ], [ "仕入先", @order.supplier.name ], [ "状態", PurchaseOrder::STATUS_LABELS[@order.status] ], [ "発注日", @order.ordered_on ], [ "入荷予定", @order.expected_on ], [ "合計", yen(@order.total_amount) ], [ "備考", @order.note ] ]) %>
    <%= form_with url: receive_dashboard_purchase_order_path(@order), method: :post do |f| %>
      <%= data_table([ "商品", "発注数", "入荷済み", "原価", "今回の入荷" ], @order.items.includes(:product).map { |i| [ "#{i.product.code} #{i.product.name}", i.quantity, i.received_quantity, yen(i.unit_cost),
            can_write? && @order.receivable? ? number_field_tag("received[#{i.id}]", i.remaining, min: 0, max: i.remaining) : "-" ] }) %>
      <% if can_write? && @order.receivable? %><%= f.submit "入荷を登録", class: "btn-signup" %><% end %>
    <% end %>
    <% if can_write? %>
      <% if @order.draft? %>
        <%= button_to "発注を確定", place_dashboard_purchase_order_path(@order), class: "btn-signup" %>
        <%= link_to "編集", edit_dashboard_purchase_order_path(@order), class: "btn-sm btn-outline" %>
        <%= button_to "削除", dashboard_purchase_order_path(@order), method: :delete, class: "btn-sm btn-danger-outline", data: { turbo_confirm: "削除しますか？" } %>
      <% elsif @order.ordered? %>
        <%= button_to "発注を取り消す", cancel_dashboard_purchase_order_path(@order), class: "btn-sm btn-danger-outline", data: { turbo_confirm: "取り消しますか？" } %>
      <% end %>
    <% end %>
  </div>
</div>
