<%# ダッシュボード: 勤怠 %>
<%= page_header "勤怠" do %>
  <%= link_to dashboard_attendances_path(request.query_parameters.merge(format: :csv)), class: "btn btn-secondary", data: { turbo: false } do %><%= icon(:download, size: 18) %>CSVで出力<% end %>
<% end %>
<%= render layout: "dashboard/shared/filter", locals: { url: dashboard_attendances_path, stores: @stores } do |f| %><% end %>
<h3>従業員ごとの合計</h3>
<%= data_table([ "従業員", "日数", "働いた時間" ], @totals.map { |e, days, minutes| [ e.name, "#{days}日", "#{minutes / 60}時間#{minutes % 60}分" ] }, empty: "この期間の勤怠はありません。") %>
<h3>打刻の記録</h3>
<%= data_table([ "従業員", "店舗", "出勤 〜 退勤 / 休憩", "働いた時間", "修正した人", "" ], @attendances.map { |a|
      edit = can_write? ? tag.details(safe_join([ tag.summary("時刻を直す"),
        form_with(model: a, url: dashboard_attendance_path(a), method: :patch, scope: :attendance, class: "attendance-form") { |f| safe_join([
          f.label(:clock_in_at, "出勤", for: "in_#{a.id}"), f.datetime_local_field(:clock_in_at, id: "in_#{a.id}"), f.label(:clock_out_at, "退勤", for: "out_#{a.id}"), f.datetime_local_field(:clock_out_at, id: "out_#{a.id}"),
          f.label(:break_minutes, "休憩（分）", for: "break_#{a.id}"), f.number_field(:break_minutes, min: 0, id: "break_#{a.id}"), f.submit("保存", class: "btn btn-sm btn-primary") ]) } ])) : ""
      [ a.employee.name, a.store.name, "#{datetime(a.clock_in_at)} 〜 #{a.clock_out_at ? datetime(a.clock_out_at) : ""} / 休憩#{a.break_minutes.to_i}分",
        a.worked_minutes ? "#{a.worked_minutes / 60}時間#{a.worked_minutes % 60}分" : badge("勤務中", :warning), a.corrected_by_name.presence || "-", edit ] }, empty: "この期間の打刻はありません。") %>
<div class="pagination-wrapper"><%= paginate @attendances %></div>
