<%# ダッシュボード: 勤怠 %>
<div class="dashboard-container">
  <%= render "dashboard/shared/menu" %>
  <div class="dashboard-content card">
    <div class="subtitle"><h2>勤怠</h2></div>
    <%= form_with url: dashboard_attendances_path, method: :get do |f| %>
      <div class="filter-row">
        <div class="filter-item"><%= f.label :store_id, "店舗" %><br><%= f.select :store_id, options_from_collection_for_select(@stores, :id, :name, params[:store_id]), include_blank: "すべて" %></div>
        <div class="filter-item"><%= f.label :from, "日付（自）" %><br><%= f.date_field :from, value: @from %></div>
        <div class="filter-item"><%= f.label :to, "日付（至）" %><br><%= f.date_field :to, value: @to %></div>
        <div class="filter-item"><br><%= f.submit "検索", class: "btn-signup" %></div>
      </div>
    <% end %>
    <p><%= link_to "CSVで出力", dashboard_attendances_path(request.query_parameters.merge(format: :csv)), class: "btn-sm btn-outline" %></p>
    <h3>従業員別の合計</h3>
    <%= data_table([ "従業員", "日数", "実働" ], @totals.map { |e, days, minutes| [ e.name, days, "#{minutes / 60}時間#{minutes % 60}分" ] }) %>
    <h3>打刻</h3>
    <%= data_table([ "従業員", "店舗", "出勤 / 退勤 / 休憩（分）", "実働", "修正者" ], @attendances.map { |a| [ a.employee.name, a.store.name,
          can_write? ? form_with(model: a, url: dashboard_attendance_path(a), method: :patch, scope: :attendance) { |f| safe_join([ f.datetime_local_field(:clock_in_at), f.datetime_local_field(:clock_out_at), f.number_field(:break_minutes, min: 0, style: "width:5rem"), f.submit("修正", class: "btn-sm btn-outline") ], " ") } : "#{datetime(a.clock_in_at)} / #{datetime(a.clock_out_at)} / #{a.break_minutes}",
          a.worked_minutes ? "#{a.worked_minutes / 60}:#{(a.worked_minutes % 60).to_s.rjust(2, "0")}" : "勤務中", a.corrected_by_name ] }) %>
    <div class="pagination-wrapper"><%= paginate @attendances %></div>
  </div>
</div>
