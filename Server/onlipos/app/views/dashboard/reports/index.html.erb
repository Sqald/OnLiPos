<%# ダッシュボード: 売上レポート画面
    店舗・期間で集計した売上サマリー、支払方法別・税率別・日次/月次・担当者別・商品別ランキングの各種集計表を表示する %>
<div class="dashboard-container">
  <%= render 'dashboard/shared/menu' %>

  <div class="dashboard-content card">
    <div class="subtitle d-flex justify-content-between align-items-center">
      <h2>売上レポート</h2>
      <% if search_performed? && (@daily_summary.any? || @product_ranking.any?) %>
        <%= link_to "CSVダウンロード",
              dashboard_reports_path(format: :csv, store_id: params[:store_id], from: params[:from], to: params[:to]),
              class: "btn-signup" %>
      <% end %>
    </div>

    <%# 検索条件フォーム(店舗・期間) %>
    <div class="filters mb-3">
      <%= form_with url: dashboard_reports_path, method: :get, local: true do |f| %>
        <div class="filter-row">
          <div class="filter-item">
            <%= f.label :store_id, "店舗" %><br>
            <%= f.select :store_id,
                  options_from_collection_for_select(@stores, :id, :name, params[:store_id]),
                  { include_blank: "すべて" }, class: "form-control" %>
          </div>
          <div class="filter-item">
            <%= f.label :from, "期間（自）" %><br>
            <%= f.date_field :from, value: params[:from], class: "form-control" %>
          </div>
          <div class="filter-item">
            <%= f.label :to, "期間（至）" %><br>
            <%= f.date_field :to, value: params[:to], class: "form-control" %>
          </div>
          <div class="filter-item">
            <br>
            <%= f.submit "集計", class: "btn-signup" %>
          </div>
        </div>
      <% end %>
    </div>

    <%# 検索が未実行の場合は集計を行わず案内メッセージのみ表示 %>
    <% unless search_performed? %>
      <div class="empty-message">
        <p>店舗または期間を指定して集計してください。</p>
      </div>
    <% else %>

      <%# サマリーカード %>
      <div class="d-flex gap-3 mb-4" style="flex-wrap: wrap;">
        <div class="card" style="padding: 16px 24px; min-width: 180px;">
          <div style="color: #888; font-size: 13px;">売上合計</div>
          <div style="font-size: 28px; font-weight: bold; color: #e53935;"><%= number_to_currency(@total_sales_amount, unit: "¥") %></div>
        </div>
        <div class="card" style="padding: 16px 24px; min-width: 180px;">
          <div style="color: #888; font-size: 13px;">取引件数</div>
          <div style="font-size: 28px; font-weight: bold;"><%= @total_sales_count %> 件</div>
        </div>
        <% if @total_sales_count > 0 %>
        <div class="card" style="padding: 16px 24px; min-width: 180px;">
          <div style="color: #888; font-size: 13px;">客単価</div>
          <div style="font-size: 28px; font-weight: bold;"><%= number_to_currency(@total_sales_amount / @total_sales_count, unit: "¥") %></div>
        </div>
        <% end %>
        <% if @total_discount > 0 %>
        <div class="card" style="padding: 16px 24px; min-width: 180px;">
          <div style="color: #888; font-size: 13px;">値引き合計</div>
          <div style="font-size: 28px; font-weight: bold; color: #e53935;">-<%= number_to_currency(@total_discount, unit: "¥") %></div>
        </div>
        <% end %>
      </div>

      <%# 支払い方法別集計 %>
      <% if @payment_summary.any? %>
        <h3>支払い方法別集計</h3>
        <table class="data-table mb-4">
          <thead>
            <tr>
              <th>支払い方法</th>
              <th class="text-right">件数</th>
              <th class="text-right">金額</th>
            </tr>
          </thead>
          <tbody>
            <% @payment_summary.each do |row| %>
              <tr>
                <td><%= row[:label] %></td>
                <td class="text-right"><%= row[:count] %> 件</td>
                <td class="text-right"><%= number_to_currency(row[:amount], unit: "¥") %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% end %>

      <%# 税率別売上（インボイス確定値ベース） %>
      <% if @tax_summary.any? %>
        <h3>税率別売上</h3>
        <table class="data-table mb-4">
          <thead>
            <tr>
              <th>税率</th>
              <th class="text-right">売上(税込)</th>
              <th class="text-right">うち消費税</th>
              <th class="text-right">返品(税込)</th>
              <th class="text-right">純売上(税込)</th>
              <th class="text-right">純消費税</th>
            </tr>
          </thead>
          <tbody>
            <% @tax_summary.each do |row| %>
              <tr>
                <td><%= row[:tax_rate] %>%</td>
                <td class="text-right"><%= number_to_currency(row[:sales_amount], unit: "¥") %></td>
                <td class="text-right"><%= number_to_currency(row[:sales_tax], unit: "¥") %></td>
                <td class="text-right"><%= number_to_currency(row[:refund_amount], unit: "¥") %></td>
                <td class="text-right"><%= number_to_currency(row[:net_amount], unit: "¥") %></td>
                <td class="text-right"><%= number_to_currency(row[:net_tax], unit: "¥") %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% end %>

      <%# 返品・取消 %>
      <% if (@refund_count.to_i + @void_count.to_i) > 0 %>
        <h3>返品・取消</h3>
        <table class="data-table mb-4">
          <thead>
            <tr>
              <th>区分</th>
              <th class="text-right">件数</th>
              <th class="text-right">金額</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>返品</td>
              <td class="text-right"><%= @refund_count %> 件</td>
              <td class="text-right"><%= number_to_currency(@refund_total, unit: "¥") %></td>
            </tr>
            <tr>
              <td>取消(VOID)</td>
              <td class="text-right"><%= @void_count %> 件</td>
              <td class="text-right"><%= number_to_currency(@void_total, unit: "¥") %></td>
            </tr>
          </tbody>
        </table>
      <% end %>

      <%# 日次売上 %>
      <% if @daily_summary.any? %>
        <h3>日次売上</h3>
        <table class="data-table mb-4">
          <thead>
            <tr>
              <th>日付</th>
              <th class="text-right">件数</th>
              <th class="text-right">売上金額</th>
            </tr>
          </thead>
          <tbody>
            <% @daily_summary.each do |row| %>
              <tr>
                <td><%= row[:day] %></td>
                <td class="text-right"><%= row[:count] %> 件</td>
                <td class="text-right"><%= number_to_currency(row[:amount], unit: "¥") %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% end %>

      <%# 月次売上 %>
      <% if @monthly_summary.any? %>
        <h3>月次売上</h3>
        <table class="data-table mb-4">
          <thead>
            <tr>
              <th>年月</th>
              <th class="text-right">件数</th>
              <th class="text-right">売上金額</th>
            </tr>
          </thead>
          <tbody>
            <% @monthly_summary.each do |row| %>
              <tr>
                <td><%= row[:month] %></td>
                <td class="text-right"><%= row[:count] %> 件</td>
                <td class="text-right"><%= number_to_currency(row[:amount], unit: "¥") %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% end %>

      <%# 担当者別売上 %>
      <% if @employee_summary.any? %>
        <h3>担当者別売上</h3>
        <table class="data-table mb-4">
          <thead>
            <tr>
              <th>コード</th>
              <th>担当者名</th>
              <th class="text-right">件数</th>
              <th class="text-right">売上金額</th>
            </tr>
          </thead>
          <tbody>
            <% @employee_summary.each do |row| %>
              <tr>
                <td><%= row[:code] %></td>
                <td><%= row[:name] %></td>
                <td class="text-right"><%= row[:count] %> 件</td>
                <td class="text-right"><%= number_to_currency(row[:amount], unit: "¥") %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% end %>

      <%# 商品別売上ランキング %>
      <% if @product_ranking.any? %>
        <h3>商品別売上ランキング（上位20件）</h3>
        <table class="data-table">
          <thead>
            <tr>
              <th>順位</th>
              <th>商品名</th>
              <th class="text-right">販売数</th>
              <th class="text-right">売上金額</th>
            </tr>
          </thead>
          <tbody>
            <% @product_ranking.each_with_index do |row, idx| %>
              <tr>
                <td><%= idx + 1 %></td>
                <td><%= row[:name] %></td>
                <td class="text-right"><%= row[:quantity] %> 個</td>
                <td class="text-right"><%= number_to_currency(row[:amount], unit: "¥") %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% end %>

      <%# 客層キー別売上（性別・年代） %>
      <% if @customer_segment_summary.any? %>
        <h3>客層キー別売上</h3>
        <table class="data-table">
          <thead>
            <tr>
              <th>性別</th>
              <th>年代</th>
              <th class="text-right">件数</th>
              <th class="text-right">売上金額</th>
            </tr>
          </thead>
          <tbody>
            <% @customer_segment_summary.each do |row| %>
              <tr>
                <td><%= row[:gender] %></td>
                <td><%= row[:age_group] %></td>
                <td class="text-right"><%= row[:count] %> 件</td>
                <td class="text-right"><%= number_to_currency(row[:amount], unit: "¥") %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% end %>

      <% if @daily_summary.empty? && @product_ranking.empty? %>
        <div class="empty-message">
          <p>該当する売上データがありません。</p>
        </div>
      <% end %>

    <% end %>
  </div>
</div>
