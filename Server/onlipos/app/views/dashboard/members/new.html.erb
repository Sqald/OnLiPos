<%# ダッシュボード: メンバーの追加 %>
<%= page_header "メンバーを追加", back: true %>
<div class="dashboard-content form-narrow">
  <%= form_errors(@member) %>
  <%= form_with model: @member, url: dashboard_members_path, method: :post, scope: :user do |f| %>
    <div class="name-pair">
      <div class="field"><label for="user_last_name">姓<%= required_mark %></label><%= f.text_field :last_name, required: true %></div>
      <div class="field"><label for="user_first_name">名<%= required_mark %></label><%= f.text_field :first_name, required: true %></div>
    </div>
    <div class="field"><label for="user_login_name">ログイン名<%= required_mark %></label><%= f.text_field :login_name, required: true, autocapitalize: "none" %><p class="field-hint">半角英数字4〜16文字</p></div>
    <div class="field"><label for="user_email">メールアドレス<%= required_mark %></label><%= f.email_field :email, required: true %></div>
    <div class="field"><%= f.label :role, "役割" %><%= f.select :role, [ [ role_label("manager"), "manager" ], [ role_label("viewer"), "viewer" ] ] %><p class="field-hint">「管理者」は商品や店舗などを変更できます。「閲覧のみ」は見るだけです。</p></div>
    <div class="actions"><%= f.submit "追加する" %><%= link_to "やめる", dashboard_members_path, class: "link-cancel" %></div>
  <% end %>
</div>
