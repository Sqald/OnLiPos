<%# ダッシュボード: 従業員一覧 %>
<%= page_header "従業員", lead: "レジを操作する人を登録します。返品や値引きなどの操作には、PINと権限の設定が必要です。" do %>
  <% if can_write? %><%= link_to new_dashboard_employee_path, class: "btn btn-primary" do %><%= icon(:plus, size: 18) %>従業員を登録<% end %><% end %>
<% end %>
<%= data_table([ "番号", "名前", "働く店舗", "PIN", "できる操作", "操作" ], @employees.map { |e|
      keys = e.permission_keys
      [ tag.span(e.code), e.name, e.is_all_stores? ? badge("全店舗") : (e.stores.map(&:name).join("、").truncate(30).presence || badge("店舗未設定", :warning)),
        e.pin_digest.present? ? badge("設定済み") : badge("未設定", :warning),
        keys.size == Employee::PERMISSION_CATALOG.size ? "すべて" : (keys.any? ? safe_join([ Employee::PERMISSION_CATALOG.values_at(*keys.first(3)).compact.join("、"), ("ほか#{keys.size - 3}件" if keys.size > 3) ].compact, " ") : "会計のみ"),
        can_write? ? row_actions(
          link_to("編集", edit_dashboard_employee_path(e), class: "btn btn-sm btn-secondary"),
          button_to("削除", dashboard_employee_path(e), method: :delete, class: "btn btn-sm btn-danger-outline", form: { data: { turbo_confirm: "「#{e.name}」を削除しますか？" } })) : "" ] },
      empty: "従業員がまだ登録されていません。", action: (link_to("はじめの従業員を登録する", new_dashboard_employee_path, class: "btn btn-primary") if can_write?)) %>
