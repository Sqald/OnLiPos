<%# ダッシュボード: 従業員の登録/編集フォーム（番号・氏名・PIN・働く店舗・できる操作） %>
<%= form_with(model: [ :dashboard, employee ], class: "dashboard-form") do |f| %>
  <%= form_errors(employee) %>
  <fieldset class="form-section">
    <legend>基本</legend>
    <div class="field"><label for="employee_code">従業員番号<%= required_mark %></label><%= f.text_field :code, placeholder: "例: 1001", autofocus: true, inputmode: "numeric" %><p class="field-hint">1〜12桁。レジで担当者を選ぶときに入力します。</p></div>
    <div class="field"><label for="employee_name">名前<%= required_mark %></label><%= f.text_field :name, placeholder: "例: 山田 太郎" %></div>
    <div class="field-pair">
      <div class="field"><label for="employee_pin">PIN（4〜6桁の数字）</label><%= f.password_field :pin, placeholder: employee.persisted? ? "変更するときだけ入力" : "数字のみ", inputmode: "numeric", autocomplete: "new-password" %></div>
      <div class="field"><label for="employee_pin_confirmation">PIN（確認のためもう一度）</label><%= f.password_field :pin_confirmation, inputmode: "numeric", autocomplete: "new-password" %></div>
    </div>
    <p class="field-hint">PINがない従業員は、レジ開設・返品・値引きなど、本人確認が必要な操作ができません。</p>
  </fieldset>

  <fieldset class="form-section">
    <legend>働く店舗</legend>
    <%# 「全店舗」との連動は store_select_controller.js（Stimulus）で行う %>
    <div class="store-selection-box" data-controller="store-select">
      <div class="store-selection-header">
        <label class="checkbox-label-bold"><%= f.check_box :is_all_stores, id: "select-all-stores", class: "store-checkbox-master", data: { store_select_target: "all", action: "store-select#toggleAll" } %> すべての店舗</label>
      </div>
      <div class="store-grid">
        <%= f.collection_check_boxes :store_ids, @stores, :id, :name do |b| %>
          <div class="checkbox-item"><%= b.check_box(class: "store-checkbox", data: { store_select_target: "store", action: "store-select#toggleStore" }) %><%= b.label(class: "store-label") %></div>
        <% end %>
      </div>
    </div>
  </fieldset>

  <fieldset class="form-section">
    <legend>できる操作</legend>
    <p class="field-hint">チェックした操作だけできます。ふつうの会計には権限は必要ありません。</p>
    <% current_permissions = employee.new_record? ? Set.new : employee.permission_keys.to_set %>
    <div class="store-grid">
      <% Employee::PERMISSION_CATALOG.each do |key, label| %>
        <div class="checkbox-item"><%= check_box_tag "employee[permission_keys][]", key, current_permissions.include?(key), id: "permission_#{key}", class: "store-checkbox" %><label for="permission_<%= key %>" class="store-label"><%= label %></label></div>
      <% end %>
    </div>
  </fieldset>

  <div class="actions"><%= f.submit employee.new_record? ? "登録する" : "変更を保存" %><%= link_to "やめる", dashboard_employees_path, class: "link-cancel" %></div>
<% end %>
