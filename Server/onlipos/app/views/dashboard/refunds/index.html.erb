<%# ダッシュボード: 返品一覧（初期表示は過去7日） %>
<%= page_header "返品一覧" %>
<%= render layout: "dashboard/shared/filter", locals: { url: dashboard_refunds_path, stores: @stores } do |f| %><% end %>
<%= result_count(@refunds) %>
<%= data_table([ "日時", "店舗", "返品番号", "元のレシート番号", "返金額", "" ], @refunds.map { |r|
      [ datetime(r.created_at), r.store.name, r.refund_receipt_number, link_to(r.sale.receipt_number, dashboard_sale_detail_path(r.sale)), yen(r.total_amount),
        row_actions(link_to("くわしく", dashboard_refund_path(r), class: "btn btn-sm btn-secondary")) ] }, empty: "この条件の返品はありません。") %>
<div class="pagination-wrapper"><%= paginate @refunds %></div>
