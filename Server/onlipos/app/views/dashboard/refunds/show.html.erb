<%# ダッシュボード: 返品の詳細 %>
<%= page_header "返品の詳細", back: true %>
<%= detail_table([ [ "日時", datetime(@refund.created_at) ], [ "店舗", @refund.store.name ], [ "返品番号", @refund.refund_receipt_number ],
      [ "元のレシート番号", link_to(@refund.sale.receipt_number, dashboard_sale_detail_path(@refund.sale)) ], [ "返金の合計", tag.strong(yen(@refund.total_amount)) ] ]) %>
<h3>返品した商品</h3>
<%= data_table([ "商品名", "数量", "単価", "小計" ], @refund.refund_details.map { |d| [ d.product_name, d.quantity, yen(d.unit_price), yen(d.subtotal) ] }) %>
