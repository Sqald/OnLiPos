<%# ダッシュボード: 契約アカウントの設定 %>
<div class="dashboard-container">
  <%= render "dashboard/shared/menu" %>
  <div class="dashboard-content card">
    <div class="subtitle"><h2>契約アカウントの設定</h2></div>
    <%= form_errors(@account) %>
    <%= form_with model: @account, url: dashboard_account_settings_path, method: :patch, scope: :user do |f| %>
      <div class="field">
        <%= f.label :invoice_registration_number, "適格請求書発行事業者の登録番号（T＋13桁）" %>
        <%= f.text_field :invoice_registration_number, placeholder: "T1234567890123", maxlength: 14 %>
        <p class="text-sm-muted">レシート・領収書に印字されます。免税事業者の場合は空欄にしてください。</p>
      </div>
      <div class="field">
        <%= f.label :tax_rounding_method, "消費税の端数処理" %>
        <%= f.select :tax_rounding_method, [ [ "切り捨て", "round_down" ], [ "四捨五入", "round_half_up" ], [ "切り上げ", "round_up" ] ], {}, class: "form-select" %>
      </div>
      <div class="field">
        <%= f.label :point_yen_per_point, "ポイント: 何円ごとに1ポイント付与するか（0 = 使わない。1ポイント = 1円）" %>
        <%= f.number_field :point_yen_per_point, min: 0 %>
      </div>
      <div class="field">
        <%= f.label :receipt_footer, "レシートの末尾に表示する文" %>
        <%= f.text_field :receipt_footer, maxlength: 200 %>
      </div>
      <div class="field"><label><%= f.check_box :digital_receipt_enabled %> 電子レシート（QRコード）を使う</label></div>
      <% if role_at_least?(:owner) %><div class="actions"><%= f.submit "保存" %></div><% end %>
    <% end %>
  </div>
</div>
