<%# Devise: 新規アカウント登録画面 %>
<% content_for :title, "新規登録" %>
<div class="auth-wrapper">
  <div class="auth-container wide">
    <h2>新規登録</h2>
    <p class="auth-lead">登録すると、すぐに使い始められます。</p>
    <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
      <%= form_errors(resource) %>
      <div class="field">
        <span class="field-label">アカウントの種類</span>
        <div class="radio-group">
          <%= f.radio_button :user_type, "individual", checked: resource.user_type != "corporate" %><%= f.label :user_type_individual, "個人" %>
          <%= f.radio_button :user_type, "corporate" %><%= f.label :user_type_corporate, "法人" %>
        </div>
      </div>
      <div class="field"><label for="user_company_name">会社名・屋号<%= optional_mark %></label><%= f.text_field :company_name, placeholder: "法人の場合は入力してください", autocomplete: "organization" %></div>
      <div class="name-pair">
        <div class="field"><label for="user_last_name">姓<%= required_mark %></label><%= f.text_field :last_name, autocomplete: "family-name" %></div>
        <div class="field"><label for="user_first_name">名<%= required_mark %></label><%= f.text_field :first_name, autocomplete: "given-name" %></div>
      </div>
      <div class="field"><label for="user_login_name">企業ID（POS端末で使うID）<%= required_mark %></label><%= f.text_field :login_name, autocapitalize: "none", autocomplete: "off" %><p class="field-hint">半角英数字4〜16文字</p></div>
      <div class="field"><label for="user_email">メールアドレス<%= required_mark %></label><%= f.email_field :email, autocomplete: "email" %></div>
      <div class="field"><label for="user_password">パスワード<%= required_mark %></label><%= f.password_field :password, autocomplete: "new-password" %><% if @minimum_password_length %><p class="field-hint"><%= @minimum_password_length %>文字以上</p><% end %></div>
      <div class="field"><label for="user_password_confirmation">パスワード（確認のためもう一度）<%= required_mark %></label><%= f.password_field :password_confirmation, autocomplete: "new-password" %></div>
      <div class="actions"><%= f.submit "アカウントを作る" %></div>
    <% end %>
    <div class="auth-links"><%= render "devise/shared/links" %></div>
  </div>
</div>
