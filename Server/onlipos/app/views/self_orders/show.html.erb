<%# セルフ注文（お客様のスマートフォン）。数量の増減と合計の表示は self_order_controller.js（Stimulus）で行う %>
<% content_for :title, "ご注文 | #{@store.name}" %>
<% content_for :interactive, "1" %>
<% content_for :body_class, "with-order-bar" %>
<header class="order-header"><p class="order-store"><%= @store.name %></p><p class="order-table">テーブル <strong><%= @table.table_number %></strong></p></header>
<% if @orders.any? %>
  <details class="public-card">
    <summary>注文したもの（<%= @orders.size %>回）</summary>
    <% @orders.each do |o| %>
      <p><span class="public-muted"><%= l(o.created_at.in_time_zone, format: "%H:%M") %> <strong><%= KitchenOrder::STATUS_LABELS[o.status] %></strong></span><br>
      <%= o.items.map { |i| "#{i["name"]} ×#{i["quantity"]}" }.join("、") %></p>
    <% end %>
  </details>
<% end %>
<% groups = @products.group_by { |p| p.product_category&.name || "その他" } %>
<% if groups.empty? %><div class="public-card"><p>ただいまご注文いただける商品がありません。スタッフにお声がけください。</p></div><% end %>
<% if groups.size > 1 %>
  <nav class="order-categories" aria-label="商品の種類"><% groups.keys.each_with_index do |name, i| %><a href="#cat-<%= i %>"><%= name %></a><% end %></nav>
<% end %>
<%= form_with url: self_order_path(@table.token), method: :post, data: { controller: "self-order" } do |f| %>
  <%= f.hidden_field :request_id, value: @request_id %>
  <% groups.each_with_index do |(category, products), index| %>
    <section class="public-card" id="cat-<%= index %>">
      <h2><%= category %></h2>
      <% products.each do |p| %>
        <% price = p.eat_in_price || @prices[p.id] || p.price %>
        <div class="public-menu-item" data-self-order-target="item" data-price="<%= price %>">
          <div class="public-menu-name">
            <strong><%= p.name %></strong><br><span class="public-price"><%= yen(price) %><%= "（税抜）" if p.tax_exclusive? %></span>
          </div>
          <div class="stepper">
            <button type="button" aria-label="<%= p.name %>を減らす" data-action="self-order#minus">−</button>
            <%= number_field_tag "items[#{p.id}][quantity]", 0, min: 0, max: SelfOrdersController::MAX_QUANTITY, "aria-label": "#{p.name} の数量", id: "q_#{p.id}", inputmode: "numeric", data: { action: "input->self-order#update" } %>
            <button type="button" aria-label="<%= p.name %>を増やす" data-action="self-order#plus">＋</button>
          </div>
          <% if p.option_groups.any? %>
            <div class="public-options">
              <% p.option_groups.each do |g| %>
                <p class="public-muted"><%= g.name %>（<%= g.min_select.zero? ? "#{g.max_select}つまで選べます" : "#{g.min_select}〜#{g.max_select}つ選んでください" %>）</p>
                <% g.option_items.each do |o| %><label><%= check_box_tag "items[#{p.id}][options][]", o.id, false, id: "o_#{p.id}_#{o.id}", data: { price: o.price, action: "self-order#update" } %> <%= o.name %><%= " +#{o.price}円" if o.price.positive? %></label><% end %>
              <% end %>
            </div>
          <% end %>
        </div>
      <% end %>
    </section>
  <% end %>
  <% if groups.any? %>
    <div class="order-bar"><div><span data-self-order-target="count">0</span>点 <strong data-self-order-target="total">¥0</strong></div><%= f.submit "注文する", class: "public-button", data: { self_order_target: "submit", turbo_confirm: "この内容で注文しますか？" } %></div>
  <% end %>
<% end %>
