<%# セルフ注文（お客様のスマートフォン） %>
<% content_for :title, "ご注文 | #{@store.name}" %>
<div class="public-card"><h1><%= @store.name %></h1><p>テーブル <strong><%= @table.table_number %></strong></p></div>
<% if @orders.any? %>
  <div class="public-card">
    <h2>ご注文済み</h2>
    <% @orders.each do |o| %>
      <p><span class="public-muted"><%= l(o.created_at.in_time_zone, format: "%H:%M") %> <%= KitchenOrder::STATUS_LABELS[o.status] %></span><br>
      <%= o.items.map { |i| "#{i["name"]} ×#{i["quantity"]}" }.join("、") %></p>
    <% end %>
  </div>
<% end %>
<%= form_with url: self_order_path(@table.token), method: :post do |f| %>
  <%= f.hidden_field :request_id, value: @request_id %>
  <% @products.group_by { |p| p.product_category&.name || "その他" }.each do |category, products| %>
    <div class="public-card">
      <h2><%= category %></h2>
      <% products.each do |p| %>
        <div class="public-menu-item">
          <div>
            <%= p.name %><br><span class="public-muted"><%= yen(p.eat_in_price || @prices[p.id] || p.price) %><%= "（税抜）" if p.tax_exclusive? %></span>
            <% p.option_groups.each do |g| %>
              <div class="public-muted"><%= g.name %>（<%= g.min_select %>〜<%= g.max_select %>個）
                <% g.option_items.each do |o| %><label><%= check_box_tag "items[#{p.id}][options][]", o.id, false, id: "o_#{p.id}_#{o.id}" %> <%= o.name %><%= " +#{o.price}円" if o.price.positive? %></label><% end %>
              </div>
            <% end %>
          </div>
          <%= number_field_tag "items[#{p.id}][quantity]", 0, min: 0, max: SelfOrdersController::MAX_QUANTITY, "aria-label": "#{p.name} の数量", id: "q_#{p.id}" %>
        </div>
      <% end %>
    </div>
  <% end %>
  <%= f.submit "注文する", class: "public-button" %>
<% end %>
