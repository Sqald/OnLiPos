<%# パーシャル: 操作結果のお知らせ。パスワード等を控えてもらう場合があるため、自動では消さず閉じるボタンを付ける %>
<% { notice: :check, alert: :alert }.each do |type, icon_name| %>
  <% next if (message = flash[type]).blank? || !message.is_a?(String) %>
  <div class="flash flash-<%= type %>" role="<%= type == :alert ? "alert" : "status" %>" data-controller="dismiss">
    <%= icon(icon_name) %>
    <div class="flash-body"><%= simple_format(h(message), {}, wrapper_tag: "p") %></div>
    <button type="button" class="flash-close" aria-label="閉じる" data-action="dismiss#close"><%= icon(:close, size: 18) %></button>
  </div>
<% end %>
