<%#
  パーシャル: 一般ページ共通ナビゲーションメニュー
  ログイン状態によって表示するリンクを切り替える
  （未ログイン: ログイン/新規登録、ログイン中: ダッシュボード/マイページ/ログアウト）。
  スマートフォンでもすべてのリンクを表示する。
%>
<nav class="nav-links" aria-label="サイトメニュー">
  <% if user_signed_in? %>
    <%= link_to "マイページ", edit_user_registration_path, class: "nav-link" %>
    <%= button_to "ログアウト", destroy_user_session_path, method: :delete, class: "nav-link" %>
    <%= link_to "管理画面へ", dashboard_root_path, class: "btn btn-primary btn-compact" %>
  <% else %>
    <%= link_to "ログイン", new_user_session_path, class: "nav-link" %>
    <%= link_to "新規登録", new_user_registration_path, class: "btn btn-primary btn-compact" %>
  <% end %>
</nav>
