<%#
  個別HTTPエラーページ
  @status_code / @error_info を元に、該当ステータスコードの説明を表示する。
  実際のエラー発生時、または /errors 一覧からのプレビューで表示される。
%>
<% is_server = @error_info[:category] == :server %>
<% content_for :title, "#{@error_info[:title]} (#{@status_code})" %>

<div class="error-page">
  <div class="card error-card">
    <h1 class="error-title"><%= @error_info[:ja].to_s.split("。").first %>。</h1>
    <% if (rest = @error_info[:ja].to_s.split("。").drop(1).join("。")).present? %><p class="error-desc"><%= rest %></p><% end %>
    <p class="error-desc"><%= is_server ? "しばらく待ってから、もう一度お試しください。解決しない場合は、下の番号を管理者へお伝えください。" : "お手数ですが、ホームに戻ってやり直してください。" %></p>

    <div class="error-actions">
      <%= link_to "ホームへ戻る", root_path, class: "btn-primary" %>
      <%# CSP で javascript: URL を禁止しているため、同一サイト内の参照元がある場合のみリンクを出す %>
      <%= link_to "前のページへ", @back_url, class: "btn-secondary" if @back_url %>
    </div>

    <p class="error-footer">エラー番号 <%= @status_code %>（<%= @error_info[:title] %>）</p>
  </div>
</div>
